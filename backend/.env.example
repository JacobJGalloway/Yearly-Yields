# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/yearly_yields

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Anthropic (Claude SDK) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# ── SendGrid ──────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=alerts@yearly-yields.com
SENDGRID_FROM_NAME=Yearly Yields

# ── NOAA ──────────────────────────────────────────────────────────────────────
NOAA_BASE_URL=https://api.weather.gov
NOAA_USER_AGENT=yearly-yields/0.1.0 (your@email.com)
NWS_POLL_INTERVAL_HOURS=4                                   # hours between NWS observation polls
FIOT_POLL_INTERVAL_HOURS=2.0                                # hours between fIoT greenhouse readings
FIOT_TEMP_NOISE_STDDEV_F=1.5                                # Gaussian noise stddev for simulated temp (°F)
FIOT_HUMIDITY_NOISE_STDDEV_PCT=3.0                          # Gaussian noise stddev for simulated humidity (%)
FIOT_DEFAULT_HUMIDITY_PCT=65.0                              # fallback target humidity when area value is null
PURGE_INTERVAL_HOURS=24                                     # hours between nightly sensor purge runs

# ── Data Retention ────────────────────────────────────────────────────────────
DATA_RETENTION_DAYS=1095                                    # 3 years; range 365–3650
DAILY_RETENTION_DAYS=90                                     # ~1 quarter before summarizing
SUMMARIZATION_DATES=["03-31","06-30","09-30","12-31"]       # MM-DD; quarterly by default

# ── Alerts ────────────────────────────────────────────────────────────────────
ALERT_EMAIL_INTERVAL_HOURS=24
ALERT_RESOLUTION_THRESHOLD=3

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:4200"]
